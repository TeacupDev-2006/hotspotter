# ===== OpenRouter（AI 判断）=====
# https://openrouter.ai/keys 获取
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
# 可切换模型；免费档如 nvidia/nemotron-3-super-120b-a12b:free，付费档如 z-ai/glm-4.6
AI_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ===== twitterapi.io（X/Twitter 采集）=====
# https://twitterapi.io 注册后 Dashboard 获取
TWITTER_API_KEY=new1_xxxxxxxx

# ===== QQ 邮箱 SMTP（邮件摘要推送）=====
# SMTP_USER 填 QQ 邮箱；SMTP_PASS 填授权码（非 QQ 密码），获取方式见 README
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_TO=

# ===== 服务与调度 =====
PORT=3210
# 本地代理（访问 Google/DuckDuckGo 用，如 Clash；留空则直连）
PROXY_URL=
SCAN_INTERVAL_MINUTES=30
TOPICS=AI大模型,人工智能,大语言模型
